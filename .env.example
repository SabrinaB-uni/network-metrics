# -------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# NEVER commit .env — it is already in .gitignore.
# -------------------------------------------------------------------

# How often the poller collects data, in seconds.
POLL_INTERVAL=300

# --- Aruba Central API (only needed when USE_MOCK=false) -------------
# Your regional API base URL, e.g. https://de2.api.central.arubanetworks.com
ARUBA_BASE_URL=

# Client ID + secret from the API Gateway in New Central. The app fetches the
# bearer token automatically from HPE GreenLake — no tokens to paste.
ARUBA_CLIENT_ID=
ARUBA_CLIENT_SECRET=

# Dashboard login password (choose your own):
DASHBOARD_PASSWORD=
# Session signing key — leave blank to auto-generate:
SECRET_KEY=

# Optional: Slack incoming-webhook URL to push alerts to:
SLACK_WEBHOOK_URL=
