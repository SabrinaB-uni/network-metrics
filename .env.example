# -------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# NEVER commit .env — it is already in .gitignore.
# -------------------------------------------------------------------

# Data source: "true" uses built-in mock data (no credentials needed);
# "false" polls the real Aruba Central API using the settings below.
USE_MOCK=true

# How often the poller collects data, in seconds.
POLL_INTERVAL=300

# --- Aruba Central API (only needed when USE_MOCK=false) -------------
# Your regional API gateway base URL, e.g.
#   https://apigw-prod2.central.arubanetworks.com
ARUBA_BASE_URL=

# From the API Gateway app you create in Aruba Central:
ARUBA_CLIENT_ID=
ARUBA_CLIENT_SECRET=
ARUBA_ACCESS_TOKEN=
ARUBA_REFRESH_TOKEN=

# Optional — some tenants require the customer/central id:
ARUBA_CUSTOMER_ID=
